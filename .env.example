# Copy to `.env` in the repository root and fill in values. Never commit `.env`.
# The backend reads this file; the frontend reads `frontend/.env.local` (see frontend/.env.example).

APP_ENV=development
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini API key from https://aistudio.google.com/apikey (needed only for summaries).
# Free-tier quotas apply; see README. Do not send identifiable patient data to the API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Fixed generation settings (keep identical when comparing strategies).
# LLM_TEMPERATURE=0.2
# LLM_SEED=42
# LLM_TIMEOUT_SECONDS=60

# Maximum accepted PDF size in megabytes (1-50).
MAX_UPLOAD_MB=10

# Optional: MAX_PDF_PAGES=30

# Retrieval (local). Rebuild the index after changing the model or chunk sizes.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=3
# RAG_MIN_SIMILARITY=0.60
